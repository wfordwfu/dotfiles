#!/usr/bin/env zsh
# sshcontrolmaster: make the folder ssh uses for shared connections (ControlPath).
sshcontrolmaster() {
  (( $+commands[ssh] )) || return 0
  local dir=${XDG_CACHE_HOME:-$HOME/.cache}/ssh/controlmasters
  [[ -d $dir ]] && return 0
  command mkdir -p "$dir" && command chmod 700 "$dir"
}
