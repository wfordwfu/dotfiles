#!/usr/bin/env zsh
# gitenv: git helpers.
#   gitenv       build ~/.config/git/config from the template, if it doesn't exist yet
#   gitenv add   pick untracked files with fzf and stage them

_gitenv_setup() {
  local dir=${XDG_CONFIG_HOME:-$HOME/.config}/git
  local config=$dir/config template=$dir/config_template

  if [[ -f $config ]]; then
    print "gitenv: $config already exists, nothing to do"
    return 0
  fi
  [[ -r $template ]] || { print -u2 "gitenv: missing $template"; return 1 }
  (( $+commands[envsubst] )) || { print -u2 "gitenv: needs envsubst (brew install gettext)"; return 1 }

  print "gitenv: building $config"
  command mkdir -p "$dir" || return 1
  command envsubst < "$template" > "$config" || return 1

  if (( ! $+commands[gh] )); then
    print -u2 "gitenv: gh not found, so no [user] section was added."
    print -u2 "gitenv: install gh (brew install gh), then rm $config and run gitenv again."
    return 0
  fi
  if ! command gh auth status >/dev/null 2>&1; then
    print -u2 "gitenv: gh isn't signed in, so no [user] section was added."
    print -u2 "gitenv: run gh auth login, then rm $config and run gitenv again."
    return 0
  fi

  command cat << EOF >> "$config"
[user]
  name = $(command gh api user --jq '.name')
  email = $(command gh api user --jq '(.id | tostring) + "+" + .login + "@users.noreply.github.com"')
[alias]
  initFull = !sh $dir/scripts/initFull.sh
  bleach = !sh $dir/scripts/bleach.sh
  amend = commit -a --amend -C HEAD
  contains = branch --contains
  hist = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --branches

EOF
}

_add_untracked() {
  (( $+commands[fzf] )) || { print -u2 "gitenv add: needs fzf (brew install fzf)"; return 1 }

  local -a git_cmd=(command git)
  [[ $PWD == $HOME ]] && git_cmd+=(--git-dir=$HOME/.cfg/ --work-tree=$HOME)

  local -a excludes=(
    --exclude='go/*' --exclude='.vscode-server/*' --exclude='.npm/*' --exclude='.m2/*'
    --exclude='.local/state/*' --exclude='.local/share/*' --exclude='.cache/*'
    --exclude='.kube/*' --exclude='code/*'
  )
  local preview='cat {}'
  (( $+commands[bat] )) && preview='bat --color=always {}'

  local -a files
  files=(${(f)"$($git_cmd ls-files --others --full-name --exclude-standard $excludes -- |
    while IFS= read -r f; do [[ -L $f ]] || print -r -- $f; done |
    command fzf --multi --preview $preview)"})

  (( ${#files} )) || return 0
  $git_cmd add -- $files
}

gitenv() {
  case "$1" in
    add) _add_untracked ;;
    *)   _gitenv_setup ;;
  esac
}

gitenv "$@"
