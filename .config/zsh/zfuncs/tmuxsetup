# tmuxsetup: install tpm (the tmux plugin manager), or update it if it's there.
# Runs in the background through zfuncs_periodic.
# If tmux plugins misbehave: rm -rf ~/.cache/tmux and
# ~/.local/state/zsh/periodic/tmux.stamp, then open a new shell.
tmuxsetup() {
  (( $+commands[tmux] )) || return 0
  local tpm=${XDG_CACHE_HOME:-$HOME/.cache}/tmux/plugins/tpm
  if [[ -d $tpm ]]; then
    command git -C "$tpm" pull --ff-only --quiet
  else
    command mkdir -p "${tpm:h}" && command git clone --depth 1 --quiet https://github.com/tmux-plugins/tpm "$tpm"
  fi
}
