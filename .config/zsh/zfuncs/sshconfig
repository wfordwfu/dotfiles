#!/usr/bin/env zsh
# sshconfig: make sure ~/.ssh/config includes the config from these dotfiles.
# Creates ~/.ssh/config and an example ~/.ssh/hosts if they don't exist.
sshconfig() {
  local ssh_dir=$HOME/.ssh
  local hosts=$ssh_dir/hosts config=$ssh_dir/config
  local include_line="Include ~/.config/ssh/config"
  local include_hosts="Include ~/.ssh/hosts"
  local first tmp

  command mkdir -p "$ssh_dir" && command chmod 700 "$ssh_dir" || return 1

  if [[ ! -f $hosts ]]; then
    command cat << EOF > "$hosts"
Host examplealias
     HostName fqdn
     User user
EOF
  fi

  if [[ ! -f $config ]]; then
    command cat << EOF > "$config"
$include_line

$include_hosts

EOF
    command chmod 600 "$config"
    print "$config created"
    return 0
  fi

  IFS= read -r first < "$config"
  if [[ $first != "$include_line"* ]]; then
    tmp=$(command mktemp) || return 1
    { print -r -- "$include_line"; print; command cat "$config" } >| "$tmp" &&
      command mv "$tmp" "$config" &&
      print "Prepended Include line to $config"
  fi
}
