#!/usr/bin/env zsh
# dotfiles-test: checks on the dotfiles repo. Exits nonzero if any check fails.
emulate -L zsh

cfg() { git --git-dir="$HOME/.cfg" --work-tree="$HOME" "$@" }

failed=0
check() {  # usage: check "<description>" <function>
  if "$2"; then print "$1 -> OK"; else print "$1 -> FAIL"; failed=$((failed + 1)); fi
}

repo_found() { cfg rev-parse --git-dir >/dev/null 2>&1 }

no_hardcoded_home() {
  local hits
  hits=$(cd "$HOME" && cfg ls-files -z | xargs -0 grep -nE '/(Users|home)/' | grep -vE 'linuxbrew|/home/user/')
  [[ -z $hits ]] || { print -r -- "$hits"; return 1 }
}

zshenv_only_exports() {
  awk '
    /^[[:space:]]*(#|$)/ { next }                 # skip comments and blank lines
    cont { cont = /\\$/; next }                    # skip continuation lines
    { cont = /\\$/ }
    $0 !~ /^export [A-Za-z_][A-Za-z0-9_]*=/ { print FILENAME ":" FNR ": " $0; bad = 1 }
    END { exit bad }
  ' "$HOME/.zshenv"
}

zfuncs_work_on_first_call() {
  local file name last
  local -a defs public bad
  for file in "$HOME"/.config/zsh/zfuncs/*(N); do
    name=${file:t}
    defs=(${(f)"$(grep -oE '^[[:space:]]*(function[[:space:]]+)?[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*\(\)' "$file" \
      | sed -E 's/^[[:space:]]*(function[[:space:]]+)?//; s/[[:space:]]*\(\)//')"})
    public=(${defs:#_*})
    if [[ "${public[*]}" != "$name" ]]; then
      bad+=("$name: public functions should be just '$name', found: ${public[*]:-none}")
      continue
    fi
    (( ${#defs} == 1 )) && continue
    last=$(awk 'NF && $1 !~ /^#/ { l = $0 } END { print l }' "$file")
    [[ "${last//[[:space:]]/}" == "${name}\"\$@\"" ]] ||
      bad+=("$name: has helper functions, so its last line must be: $name \"\$@\"")
  done
  (( ${#bad} == 0 )) || { print -rl -- $bad; return 1 }
}

bootstrap_reports_missing() {
  local out
  out=$(zsh -f -c "source ${(q)HOME}/.config/zsh/bootstrap.zsh && fpath=(${(q)HOME}/.config/zsh/zfuncs) && zfuncs_load --run no_such_function" 2>&1)
  (( $? == 1 )) && [[ $out == *"zfuncs_load: no_such_function failed to load"* ]] ||
    { print -r -- "$out"; return 1 }
}

completions_quiet_without_plugins() {
  local tmp out rc
  tmp=$(mktemp -d)
  out=$(HOME=$tmp ZDOTDIR=$tmp zsh -f -c "fpath=(${(q)HOME}/.config/zsh/zfuncs \$fpath); autoload -Uz completions && completions && (( \$+functions[compdef] ))" 2>&1)
  rc=$?
  rm -rf "$tmp"
  [[ $rc == 0 && -z $out ]] || { print -r -- "${out:-exit status $rc}"; return 1 }
}

periodic_behaves() {
  local tmp out rc=0
  tmp=$(mktemp -d)
  out=$(XDG_STATE_HOME=$tmp zsh -f -c "
    fpath=(${(q)HOME}/.config/zsh/zfuncs \$fpath); autoload -Uz periodic
    periodic t 1d print reminder-test        # due: prints a reminder
    periodic t 1d print reminder-test        # not due: silent
    periodic r 1d --run touch ${(q)tmp}/ran  # due: runs in the background
    sleep 1
    [[ -f ${(q)tmp}/ran ]] && print ran
  " 2>&1)
  [[ $out == $'t: due. Run: print reminder-test\nran' ]] || { print -r -- "$out"; rc=1 }
  rm -rf "$tmp"
  return $rc
}

check "dotfiles repo found at ~/.cfg" repo_found
check "no hard-coded home paths" no_hardcoded_home
check ".zshenv only sets environment variables" zshenv_only_exports
check "each zfuncs file works on its first call" zfuncs_work_on_first_call
check "bootstrap loader reports a missing function" bootstrap_reports_missing
check "completions runs quietly with no plugins" completions_quiet_without_plugins
check "periodic reminds, stays quiet, and runs in the background" periodic_behaves

exit $(( failed > 0 ))
